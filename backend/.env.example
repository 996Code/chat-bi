# ChatBI Environment Configuration
# Copy this file to .env and fill in the values

# App
APP_ENV=development
APP_PORT=8000
API_PREFIX=/chat-bi/api/v1

# Secrets (REQUIRED — generate with: openssl rand -hex 32)
SECRET_KEY=
DATA_SOURCE_ENCRYPTION_KEY=

# Database (default: MySQL on 192.168.3.110)
DATABASE_URL=mysql+aiomysql://root:yjt_mysql@192.168.3.110:3306/chatbi

# Redis (query cache, rate limits)
REDIS_URL=redis://192.168.3.110:6379/0
QUERY_CACHE_TTL_SECONDS=3600

# LLM (OpenAI-compatible API — provide your own key)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_INTENT_TEMPERATURE=0.0
LLM_INTENT_MAX_TOKENS=10
LLM_GENERATION_TEMPERATURE=0.0
LLM_GENERATION_MAX_TOKENS=2000
LLM_SELF_HEAL_MAX_RETRIES=2

# Query
QUERY_MAX_ROWS=1000
SQL_EXECUTION_TIMEOUT=30
QUERY_PIPELINE_TIMEOUT=35
STREAM_QUERY_TIMEOUT=60
CONVERSATION_HISTORY_MAX_TURNS=5

# Connection pool
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# JWT (minutes/days)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Token expiry (seconds)
RESET_TOKEN_EXPIRE_SECONDS=1800
VERIFICATION_TOKEN_EXPIRE_SECONDS=86400

# Login lock
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_DURATION_SECONDS=900

# Rate limiting
RATE_LIMIT_DEFAULT_MAX=60
RATE_LIMIT_DEFAULT_WINDOW=60
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW=60
RATE_LIMIT_QUERY_MAX=30
RATE_LIMIT_QUERY_WINDOW=60

# RAG semantic retrieval
RAG_MAX_TABLES=5
RAG_MAX_COLUMNS=15
RAG_NAME_SIM_THRESHOLD=0.5
RAG_DESC_SIM_THRESHOLD=0.4
RAG_COLUMN_SIM_THRESHOLD=0.5

# SMTP (email verification / password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# CORS (dev default: localhost:5173)
# CORS_ORIGINS=["http://localhost:5173"]

# Frontend URL (email links, password reset links)
FRONTEND_URL=http://localhost:5173

# Bcrypt rounds
BCRYPT_ROUNDS=12

# Logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
