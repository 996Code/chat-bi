# ChatBI v2 — Environment Variable Template
#
# Copy this file to .env and edit:
#   cp .env.example .env
#
# 对标 v1 经验教训 #44: 安全密钥使用 CHANGE_ME 占位符，不要放真实值
# 对标 v1 经验教训 #1: 所有配置集中管理，通过环境变量控制

# ── Application ──────────────────────────────────────────────────
APP_NAME=ChatBI v2
DEBUG=false
API_PREFIX=/chat-bi/api/v1
HOST=0.0.0.0
PORT=8999
CORS_ORIGINS=["http://localhost:5173","http://localhost:28080"]

# ── Database (PostgreSQL) ────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chatbi

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Milvus (Vector Database) ─────────────────────────────────────
MILVUS_URL=http://localhost:19530
MILVUS_TOKEN=root:Milvus

# ── LLM (OpenAI-compatible API) ──────────────────────────────────
LLM_URL=http://localhost:8000/v1
LLM_MODEL=qwen3-30b
LLM_API_KEY=EMPTY
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=60

# ── Embedding ────────────────────────────────────────────────────
EMBEDDING_URL=http://localhost:8000/v1
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_API_KEY=EMPTY

# ── Security — CHANGE THESE IN PRODUCTION! ──────────────────────
SECRET_KEY=CHANGE_ME_SECRET_KEY
FERNET_KEY=CHANGE_ME_FERNET_KEY

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_RETENTION_DAYS=14