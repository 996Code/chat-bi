# ChatBI Environment Configuration
# Copy this file to .env and fill in the values

# App
APP_ENV=development

# Secrets (REQUIRED — generate with: openssl rand -hex 32)
SECRET_KEY=
DATA_SOURCE_ENCRYPTION_KEY=

# Database (default SQLite for local dev)
DATABASE_URL=sqlite+aiosqlite:///./chatbi.db

# LLM (OpenAI-compatible API — provide your own key)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o

# SMTP (email verification / password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# CORS (dev default: localhost:5173)
# CORS_ORIGINS=["http://localhost:5173"]
