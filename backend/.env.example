# ChatBI v2 — Environment Variable Template
#
# Copy this file to .env and edit:
#   cp .env.example .env
#
# 对标 v1 经验教训 #44: 安全密钥使用 CHANGE_ME 占位符，不要放真实值
# 对标 v1 经验教训 #1: 所有配置集中管理，通过环境变量控制
#
# 占位符说明:
#   CHANGE_ME_* = 必须替换 (启动校验会拒绝占位符)
#   其他值 = 有合理默认值, 按需覆盖

# ── Application ──────────────────────────────────────────────────
APP_NAME=ChatBI v2
DEBUG=false
API_PREFIX=/chat-bi/api/v1
HOST=0.0.0.0
PORT=8999
CORS_ORIGINS=["http://localhost:5173","http://localhost:28080"]

# ── Database (PostgreSQL) ────────────────────────────────────────
# 真实凭证走 .env，不用 v1 默认 postgres:postgres (fail-closed)
DATABASE_URL=CHANGE_ME_DATABASE_URL
# 元数据连接池参数 (生产环境常调)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── Redis ────────────────────────────────────────────────────────
# 格式: redis://:密码@主机:端口/数据库号
# 示例: redis://:redis_pass@localhost:6379/0
REDIS_URL=CHANGE_ME_REDIS_URL

# ── Milvus (Vector Database) ─────────────────────────────────────
MILVUS_URL=CHANGE_ME_MILVUS_URL
MILVUS_TOKEN=CHANGE_ME_MILVUS_TOKEN
# 向量存储后端: milvus(生产) / mock(测试/降级, 纯内存)
VECTOR_STORE_BACKEND=milvus
# collection 名前缀: 测试/开发/多实例隔离 (空 = 无前缀)
VECTOR_STORE_COLLECTION_PREFIX=

# ── LLM (OpenAI-compatible API) ──────────────────────────────────
# v2 用讯飞 MAAS / vLLM 等 OpenAI 兼容协议；不写死 v1 的 qwen3-30b/EMPTY
LLM_URL=CHANGE_ME_LLM_URL
LLM_MODEL=CHANGE_ME_LLM_MODEL
LLM_API_KEY=CHANGE_ME_LLM_API_KEY
# 推理模型思考阶段消耗大量 token, 输出预算必须覆盖思考+输出, 否则截断
LLM_MAX_TOKENS=262144
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=600
# LLM HTTP 连接/重试参数 (生产环境常调)
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1.0
LLM_CONNECT_TIMEOUT=10.0
LLM_WRITE_TIMEOUT=10.0
LLM_POOL_TIMEOUT=10.0

# ── Embedding ────────────────────────────────────────────────────
# backend: local=本地 sentence-transformers / api=外部 OpenAI 兼容
EMBEDDING_BACKEND=local
# 本地模型路径 (默认 backend/models/bge-large-zh-v1.5/)
EMBEDDING_MODEL_PATH=
# BGE-large-zh-v1.5 维度, 换模型需同步调整
EMBEDDING_DIM=1024
# api 模式配置 (EMBEDDING_BACKEND=api 时启用)
EMBEDDING_URL=CHANGE_ME_EMBEDDING_URL
EMBEDDING_MODEL=CHANGE_ME_EMBEDDING_MODEL
EMBEDDING_API_KEY=CHANGE_ME_EMBEDDING_API_KEY

# ── Security — CHANGE THESE IN PRODUCTION! ──────────────────────
SECRET_KEY=CHANGE_ME_SECRET_KEY
FERNET_KEY=CHANGE_ME_FERNET_KEY
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=30

# ── SQL Execution ────────────────────────────────────────────────
SQL_EXECUTION_TIMEOUT=30
SQL_MAX_ROWS=10000
SQL_SLOW_QUERY_THRESHOLD=10.0
SQL_RESULT_CHUNK_SIZE=1000
SQL_SELF_HEAL_MAX_ROUNDS=2
SQL_SELF_HEAL_CIRCUIT_BREAKER=3

# ── Business DB Engine Pool (动态业务库连接池) ──────────────────
BUSINESS_DB_POOL_SIZE=2
BUSINESS_DB_MAX_OVERFLOW=3
BUSINESS_DB_POOL_RECYCLE=1800

# ── Agent ────────────────────────────────────────────────────────
AGENT_MAX_LLM_CALLS_PER_QUERY=20
AGENT_LOOP_RECURSION_LIMIT=50

# ── Conversation (对话相关) ──────────────────────────────────────
CONVERSATION_TITLE_MAX_LENGTH=16
STATE_STORE_ROW_SAMPLE_LIMIT=50

# ── Scan (数据源扫描) ───────────────────────────────────────────
SCAN_LLM_ENRICHMENT_TIMEOUT=600
# ChatBI 系统表 (扫描/问题生成时跳过, 新增系统表只需改此处)
SYSTEM_TABLES=["tenants","users","data_sources","semantic_models","conversations","saved_queries","audit_logs","dashboards","dashboard_widgets"]

# ── Context Compression ─────────────────────────────────────────
COMPRESSION_TOKEN_THRESHOLD=0.70
COMPRESSION_KEEP_RECENT_TURNS=3
COMPRESSION_MAX_CONSECUTIVE_FAILURES=3

# ── RAG ──────────────────────────────────────────────────────────
RAG_VECTOR_TOP_K=20
RAG_SIMILARITY_THRESHOLD=0.35
RAG_MAX_FEWSHOT_EXAMPLES=3

# ── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_QUERIES_PER_MINUTE=30
RATE_LIMIT_LOGIN_PER_MINUTE=5

# ── Memory ───────────────────────────────────────────────────────
MEMORY_MAX_RECALL_COUNT=5
MEMORY_DIR=memory

# ── Skills (多租户隔离) ──────────────────────────────────────────
SKILLS_DIR=skills

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_RETENTION_DAYS=14

# ── Audit ────────────────────────────────────────────────────────
AUDIT_ENABLED=true

# ── File Paths (持久化目录) ──────────────────────────────────────
STATE_STORE_DIR=data/states
CHECKPOINTER_DIR=data/checkpoints

# ── Scheduler (定时任务) ─────────────────────────────────────────
SCHEDULER_ENABLED=true
DATASOURCE_HEALTH_CHECK_INTERVAL_SECONDS=300
DATASOURCE_HEALTH_CHECK_MAX_FAILURES=3
METADATA_AUTO_REFRESH_INTERVAL_HOURS=6
ASYNC_TASK_RETENTION_HOURS=24

# ── Prompt Dump (debug/observability) ───────────────────────────
PROMPT_DUMP_ENABLED=false
PROMPT_DUMP_DIR=logs/prompts

# ── Startup Probe (fail-fast) ───────────────────────────────────
# 必需服务探测失败 → 拒绝启动; 可选服务 → WARNING 降级
STARTUP_REQUIRED_SERVICES=["postgres"]
STARTUP_PROBE_TIMEOUT=5
