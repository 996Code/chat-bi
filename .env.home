# ==========================================
# ChatBI 统一配置 — Home (192.168.3.110)
# 复制为 .env 使用：cp .env.home .env
# ==========================================

# ---- 应用 ----
APP_ENV=development
APP_PORT=28080
LOG_LEVEL=INFO

# ---- 暴露端口（Docker） ----
CHATBI_PORT=28080

# ---- 内置 MySQL（仅 docker-compose with-mysql profile 时需要） ----
DEPLOY_MYSQL_PORT=3306
DEPLOY_MYSQL_ROOT_PASSWORD=yjt_mysql
DEPLOY_MYSQL_DATABASE=chatbi

# ---- 内置 Redis（仅 docker-compose with-redis profile 时需要） ----
DEPLOY_REDIS_PORT=6379

# ---- 后端密钥 ----
SECRET_KEY=dev-secret-key-change-in-production-0123456789abcdef
DATA_SOURCE_ENCRYPTION_KEY=dev-encryption-key-32chars0123456789

# ---- 数据库连接 ----
DATABASE_URL=mysql+aiomysql://root:yjt_mysql@192.168.3.110:3306/chatbi

# ---- Redis ----
REDIS_URL=redis://192.168.3.110:6379/0

# ---- LLM 配置（百炼 API） ----
LLM_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
LLM_API_KEY=sk-sp-494c9e75802b4f0c9422b79d7c4f8006
LLM_MODEL=qwen3.6-plus

# ---- API 路径前缀（前后端统一） ----
API_PREFIX=/chat-bi/api/v1
VITE_BASE_PATH=/chat-bi/
VITE_API_PREFIX=/chat-bi/api/v1

# ---- CORS ----
CORS_ORIGINS=["*"]

# ---- 前端 URL ----
FRONTEND_URL=http://localhost:28080/chat-bi/

# ---- SMTP（留空跳过） ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- 测试数据库 ----
MYSQL_TEST_HOST=192.168.3.110
MYSQL_TEST_PORT=3306
MYSQL_TEST_USER=root
MYSQL_TEST_PASS=yjt_mysql
MYSQL_TEST_DB=chatbi_test

PG_TEST_HOST=192.168.3.110
PG_TEST_PORT=5432
PG_TEST_USER=postgresql
PG_TEST_PASS=postgresql
PG_TEST_DB=chatbi_test
