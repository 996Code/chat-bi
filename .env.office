# ==========================================
# ChatBI 统一配置 — Office
# 复制为 .env 使用：cp .env.office .env
# ==========================================

# ---- 应用 ----
APP_ENV=production
APP_PORT=28080
LOG_LEVEL=INFO

# ---- 暴露端口（Docker） ----
CHATBI_PORT=28080

# ---- 内置 MySQL（仅 docker-compose with-mysql profile 时需要） ----
DEPLOY_MYSQL_PORT=3306
DEPLOY_MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
DEPLOY_MYSQL_DATABASE=chatbi

# ---- 内置 Redis（仅 docker-compose with-redis profile 时需要） ----
DEPLOY_REDIS_PORT=6379

# ---- 后端密钥（生产环境必须修改） ----
SECRET_KEY=CHANGE_ME_SECRET_KEY_64_CHARS_MINIMUM_xxxxxxxxxxxxxxxx
DATA_SOURCE_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_ENCRYPTION_KEY_!!

# ---- 数据库连接 ----
DATABASE_URL=mysql+aiomysql://root:CHANGE_ME_PASSWORD@OFFICE_MYSQL_IP:3306/chatbi

# ---- Redis ----
REDIS_URL=redis://OFFICE_REDIS_IP:6379/0

# ---- LLM 配置（百炼 API） ----
LLM_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
LLM_API_KEY=CHANGE_ME_API_KEY
LLM_MODEL=qwen3.6-plus

# ---- API 路径前缀（前后端统一） ----
API_PREFIX=/chat-bi/api/v1
VITE_BASE_PATH=/chat-bi/
VITE_API_PREFIX=/chat-bi/api/v1

# ---- CORS（生产环境填实际域名） ----
CORS_ORIGINS=["https://chatbi.office.example.com"]

# ---- 前端 URL ----
FRONTEND_URL=https://chatbi.office.example.com

# ---- SMTP（邮箱验证 / 密码重置） ----
SMTP_HOST=smtp.office.example.com
SMTP_PORT=587
SMTP_USER=noreply@office.example.com
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=noreply@office.example.com

# ---- 测试数据库 ----
MYSQL_TEST_HOST=OFFICE_MYSQL_IP
MYSQL_TEST_PORT=3306
MYSQL_TEST_USER=chatbi_test
MYSQL_TEST_PASS=CHANGE_ME_TEST_PASSWORD
MYSQL_TEST_DB=chatbi_test

PG_TEST_HOST=OFFICE_PG_IP
PG_TEST_PORT=5432
PG_TEST_USER=chatbi_test
PG_TEST_PASS=CHANGE_ME_TEST_PASSWORD
PG_TEST_DB=chatbi_test
