# ChatBI v2 — 部署环境变量模板
#
# cp deploy/.env.example deploy/.env → 只改需要改的
#
# DATABASE_URL / REDIS_URL / MILVUS_URL 由 docker-compose.yml 自动拼接, 无需填写
# 大部分配置已在 compose 中设默认值, 这里只需关注 LLM + 安全密钥

# ── 元数据库 ───────────────────────────────────────────────
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_DB=chatbi

# ── 业务演示库 ─────────────────────────────────────────────
SAMPLE_DB_USER=postgres
SAMPLE_DB_PASSWORD=root
SAMPLE_DB_NAME=chatbi_ecom

# ── 初始管理员 ─────────────────────────────────────────────
ADMIN_EMAIL=admin@chatbi.local
ADMIN_PASSWORD=admin123

# ── Redis ─────────────────────────────────────────────────
REDIS_PASSWORD=redis_pass

# ── Milvus ────────────────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
VECTOR_STORE_BACKEND=milvus
MILVUS_TOKEN=root:Milvus

# ── 后端 ──────────────────────────────────────────────────
APP_NAME=ChatBI v2
DEBUG=false
API_PREFIX=/chat-bi/api/v1
HOST=0.0.0.0
PORT=8999
CORS_ORIGINS=["http://localhost:28080"]

# ── LLM (必改! 改成你的 LLM 服务地址) ─────────────────────
LLM_URL=http://your-llm-host:8000/v1
LLM_MODEL=your-model-name
LLM_API_KEY=your-api-key
LLM_MAX_TOKENS=131072
LLM_TEMPERATURE=0.0

# ── Embedding (Docker 用 api 模式, 容器内无本地模型) ──────
EMBEDDING_BACKEND=api
EMBEDDING_URL=http://your-llm-host:8000/v1
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_API_KEY=your-api-key
EMBEDDING_DIM=1024

# ── 安全密钥 (生产环境务必替换!) ──────────────────────────
# 生成: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=vfidcj3SeHUkFJXRLvE0YgenVnCeBoOvDPcC2gamJzw
FERNET_KEY=k6UTm-kClsmYl765kG65vVUpN_EzTCz5NjGDpkQ-lY8=

# ── 日志 ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=/app/logs
LOG_RETENTION_DAYS=14
