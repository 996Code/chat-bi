# ChatBI v2 — 部署环境变量模板
#
# 复制到 deploy/.env 并修改:
#   cp deploy/.env.example deploy/.env
#
# 对标 v1 经验教训 #44: 安全密钥使用 CHANGE_ME 占位符

# ── 数据库 ────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=chatbi

# ── Redis ─────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── Milvus ────────────────────────────────────────────────
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY

# ── 后端 ──────────────────────────────────────────────────
APP_NAME=ChatBI v2
DEBUG=false
API_PREFIX=/chat-bi/api/v1
HOST=0.0.0.0
PORT=8999
CORS_ORIGINS=["http://localhost:28080"]

# 数据库连接
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/chatbi
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
MILVUS_URL=http://milvus:19530

# LLM (OpenAI 兼容协议, 如讯飞 MAAS / vLLM / 其他)
LLM_URL=http://your-llm-host:8000/v1
LLM_MODEL=CHANGE_ME_LLM_MODEL
LLM_API_KEY=CHANGE_ME_LLM_API_KEY
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.0

# Embedding
EMBEDDING_URL=http://your-embedding-host:8000/v1
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_API_KEY=CHANGE_ME_EMBEDDING_API_KEY

# 安全密钥（务必替换！）
SECRET_KEY=CHANGE_ME_SECRET_KEY
FERNET_KEY=CHANGE_ME_FERNET_KEY

# 日志
LOG_LEVEL=INFO
LOG_DIR=/app/logs
LOG_RETENTION_DAYS=14
