# ChatBI v2 — 部署环境变量模板
#
# 复制到 deploy/.env 并修改:
#   cp deploy/.env.example deploy/.env
#
# 对标 v1 经验教训 #44: 安全密钥使用 CHANGE_ME 占位符
#
# 注意: DATABASE_URL / REDIS_URL / MILVUS_URL / SAMPLE_DB_HOST
#       在 docker-compose.yml 中用容器服务名自动拼接,
#       此处无需手动填写。

# ── 元数据库 (ChatBI 自身) ──────────────────────────────────
POSTGRES_USER=root
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=chatbi

# ── 业务演示库 (电商示例数据) ───────────────────────────────
# 首次启动 sample-db 容器时自动创建表并灌入数据
SAMPLE_DB_USER=postgres
SAMPLE_DB_PASSWORD=CHANGE_ME_SAMPLE_DB_PASSWORD
SAMPLE_DB_NAME=chatbi_ecom

# ── 初始管理员 ─────────────────────────────────────────────
ADMIN_EMAIL=admin@chatbi.local
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ── Redis ─────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── Milvus ────────────────────────────────────────────────
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
VECTOR_STORE_BACKEND=milvus
MILVUS_TOKEN=

# ── 后端 ──────────────────────────────────────────────────
APP_NAME=ChatBI v2
DEBUG=false
API_PREFIX=/chat-bi/api/v1
HOST=0.0.0.0
PORT=8999
CORS_ORIGINS=["http://localhost:28080"]

# LLM (OpenAI 兼容协议, 如讯飞 MAAS / vLLM / 其他)
LLM_URL=http://your-llm-host:8000/v1
LLM_MODEL=CHANGE_ME_LLM_MODEL
LLM_API_KEY=CHANGE_ME_LLM_API_KEY
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.0

# Embedding (Docker 部署用 api 模式, 容器内无本地模型)
EMBEDDING_BACKEND=api
EMBEDDING_URL=http://your-embedding-host:8000/v1
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_API_KEY=CHANGE_ME_EMBEDDING_API_KEY
EMBEDDING_DIM=1024

# 安全密钥（务必替换！）
SECRET_KEY=CHANGE_ME_SECRET_KEY
FERNET_KEY=CHANGE_ME_FERNET_KEY

# 日志
LOG_LEVEL=INFO
LOG_DIR=/app/logs
LOG_RETENTION_DAYS=14
