# ==========================================
# ChatBI 部署配置
# 复制为 deploy/.env 并修改实际值
# ==========================================

# ---- 暴露端口 ----
CHATBI_PORT=8080
MYSQL_PORT=3306
REDIS_PORT=6379

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=yjt_mysql
MYSQL_DATABASE=chatbi

# ---- 后端必需密钥（首次部署留空自动生成） ----
SECRET_KEY=
DATA_SOURCE_ENCRYPTION_KEY=

# ---- 数据库连接（指向 compose 内的 mysql 容器） ----
DATABASE_URL=mysql+aiomysql://root:yjt_mysql@mysql:3306/chatbi

# ---- Redis（指向 compose 内的 redis 容器） ----
REDIS_URL=redis://redis:6379/0

# ---- LLM 配置 ----
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key
LLM_MODEL=gpt-4o

# ---- CORS（生产环境填实际域名，如 ["https://chatbi.example.com"]） ----
CORS_ORIGINS=["*"]

# ---- 前端 URL（邮件验证链接等） ----
FRONTEND_URL=https://chatbi.example.com

# ---- SMTP（邮箱验证 / 密码重置，留空则跳过） ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- 日志 ----
LOG_LEVEL=INFO
