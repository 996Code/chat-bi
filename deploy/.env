# ==========================================
# ChatBI 部署配置 — Home (192.168.3.110)
# ==========================================

# ---- 暴露端口 ----
CHATBI_PORT=28080

# ---- 内置 MySQL（docker-compose profiles） ----
DEPLOY_MYSQL_PORT=3306
DEPLOY_MYSQL_ROOT_PASSWORD=yjt_mysql
DEPLOY_MYSQL_DATABASE=chatbi

# ---- 内置 Redis（docker-compose profiles） ----
DEPLOY_REDIS_PORT=6379

# ---- 后端必需密钥 ----
SECRET_KEY=dev-secret-key-change-in-production-0123456789abcdef
DATA_SOURCE_ENCRYPTION_KEY=dev-encryption-key-32chars0123456789

# ---- 数据库连接 ----
DATABASE_URL=mysql+aiomysql://root:yjt_mysql@192.168.3.110:3306/chatbi

# ---- Redis ----
REDIS_URL=redis://192.168.3.110:6379/0

# ---- LLM 配置（Mimo API） ----
LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
LLM_API_KEY=tp-crvttjrkef5rrpjyymavqpzzzkr98jl5m9gc8idas6ta5q5f
LLM_MODEL=mimo-v2.5-pro

# ---- API 路径前缀（前后端统一） ----
API_PREFIX=/chat-bi/api/v1
VITE_BASE_PATH=/chat-bi/

# ---- CORS ----
CORS_ORIGINS=["*"]

# ---- 前端 URL ----
FRONTEND_URL=http://localhost:28080/chat-bi/

# ---- SMTP（留空跳过） ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- 日志 ----
LOG_LEVEL=INFO
