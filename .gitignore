# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
*.egg

# Virtual environment
.venv/
venv/
env/

# Environment files — 所有 .env* 一律忽略，防止密钥泄露 (v1 教训 #44)
# 真实配置不入库；模板文件放 deploy/.env.example 和 backend/.env.example
.env
.env.*
!.gitignore

# Database
*.db
*.sqlite3

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Node
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.tsbuildinfo

# Logs
*.log
logs/

# Alembic (keep migrations, ignore temp)
alembic/versions/__pycache__/

# Testing
.pytest_cache/
.coverage
htmlcov/
