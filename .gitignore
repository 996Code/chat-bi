# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
*.egg

# Virtual environment
.venv/
venv/
env/

# Environment files — 所有 .env* 一律忽略，防止密钥泄露 (v1 教训 #44)
# 真实配置不入库；模板文件放 deploy/.env.example 和 backend/.env.example
# 例外: 前端 .env.development / .env.production 只含端口约定, 无密钥, 需提交
.env
.env.*
!frontend/.env.development
!frontend/.env.production
!.gitignore

# Database
*.db
*.sqlite3

# 本地基础设施数据（docker/docker-compose.infra.yml 的 bind mount）
docker/data/

# ML 模型文件（本地 embedding 模型, ~1.3GB, 不入库）
# 下载: uv run python backend/scripts/download_embedding_model.py
backend/models/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Node
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.tsbuildinfo

# Logs
*.log
logs/

# Alembic (keep migrations, ignore temp)
alembic/versions/__pycache__/

# Testing
.pytest_cache/
.coverage
htmlcov/
data/states/

# Runtime data (agent memory / vector cache — 运行时生成, 不入库)
memory/
data/
