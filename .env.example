# ==========================================
# ChatBI 统一配置模板
# 复制为 .env 并修改实际值
# 前后端、构建、部署共用此文件
# ==========================================

# ---- 应用 ----
APP_ENV=development
APP_PORT=28080
LOG_LEVEL=INFO

# ---- 暴露端口（Docker） ----
CHATBI_PORT=28080

# ---- 内置 MySQL（仅 docker-compose with-mysql profile 时需要） ----
DEPLOY_MYSQL_PORT=3306
DEPLOY_MYSQL_ROOT_PASSWORD=yjt_mysql
DEPLOY_MYSQL_DATABASE=chatbi

# ---- 内置 Redis（仅 docker-compose with-redis profile 时需要） ----
DEPLOY_REDIS_PORT=6379

# ---- 后端密钥（首次部署留空自动生成） ----
SECRET_KEY=
DATA_SOURCE_ENCRYPTION_KEY=

# ---- 数据库连接 ----
# 使用外部 MySQL（IP 模式）：
DATABASE_URL=mysql+aiomysql://root:YOUR_PASSWORD@192.168.3.110:3306/chatbi
# 使用 docker-compose 内置 MySQL（需启用 with-mysql profile）：
# DATABASE_URL=mysql+aiomysql://root:${DEPLOY_MYSQL_ROOT_PASSWORD}@mysql:3306/chatbi

# ---- Redis ----
# 使用外部 Redis（IP 模式）：
REDIS_URL=redis://192.168.3.110:6379/0
# 使用 docker-compose 内置 Redis（需启用 with-redis profile）：
# REDIS_URL=redis://redis:6379/0

# ---- LLM 配置（Mimo API） ----
LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
LLM_API_KEY=YOUR_API_KEY
LLM_MODEL=mimo-v2.5-pro

# ---- API 路径前缀（前后端统一） ----
API_PREFIX=/chat-bi/api/v1
VITE_BASE_PATH=/chat-bi/
VITE_API_PREFIX=/chat-bi/api/v1

# ---- CORS（生产环境填实际域名） ----
CORS_ORIGINS=["*"]

# ---- 前端 URL ----
FRONTEND_URL=https://chatbi.example.com

# ---- SMTP（邮箱验证 / 密码重置，留空则跳过） ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- 测试数据库 ----
MYSQL_TEST_HOST=192.168.3.110
MYSQL_TEST_PORT=3306
MYSQL_TEST_USER=root
MYSQL_TEST_PASS=
MYSQL_TEST_DB=chatbi_test

PG_TEST_HOST=
PG_TEST_PORT=5432
PG_TEST_USER=postgresql
PG_TEST_PASS=
PG_TEST_DB=chatbi_test
